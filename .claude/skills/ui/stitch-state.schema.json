{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-agents.local/schemas/sdlc.stitch-state.v2.json",
  "title": "docs/design/stitch.json — Google Stitch design state (sdlc.stitch-state/v2)",
  "description": "One Stitch project per product. Every screen of every app (web DESKTOP, React Native MOBILE) has an entry keyed <screen-slug>.<device>. The approved render is stored under docs/design/stitch/<screenKey>/ with sha256 hashes, so the phase gate can prove the code was built against the current approved baseline. Structural rules live here; cross-field rules that JSON Schema can't express (approved_rev == last history rev, render.rev == approved_rev, strictly increasing revs, the last history screenId == screenId, sync_back_pending needs an unsynced accepted deviation, low-fidelity imports need the owner) are enforced by .claude/hooks/stitch-state.py validate, which is the authority. See .claude/skills/ui/stitch-design.md §2.",
  "type": "object",
  "required": ["schema", "projectId", "screens"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "sdlc.stitch-state/v2" },
    "projectId": {
      "description": "Stitch project id (digits). null only when Stitch has never been reachable: every screen is then no_baseline with a deferral.",
      "type": ["string", "null"],
      "pattern": "^[0-9]+$"
    },
    "projectTitle": { "type": "string" },
    "designSystem": {
      "type": "object",
      "required": ["assetId", "source"],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "source": { "type": "string", "description": "docs/design/DESIGN.md | IMPLEMENTATION_GUIDELINES | <design-system pack> | import-capture | stitch-default" },
        "updated": { "type": "string" },
        "font_substitutions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["method", "at"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["import", "adopt", "greenfield"] },
        "at": { "type": "string", "format": "date-time" },
        "app_base_url": { "type": "string" },
        "pages_total": { "type": "integer", "minimum": 0 },
        "pages_imported": { "type": "integer", "minimum": 0 },
        "low_fidelity": { "type": "integer", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "screens": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*\\.(desktop|mobile|tablet)$" },
      "additionalProperties": { "$ref": "#/$defs/screen" }
    },
    "queue": {
      "description": "Stitch work waiting for the MCP or the owner: autonomous runs without Stitch, sync-backs not yet pushed.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screenKey", "op", "reason", "ts"],
        "additionalProperties": false,
        "properties": {
          "screenKey": { "type": "string" },
          "op": { "enum": ["generate", "edit", "import", "sync_back", "refresh"] },
          "reason": { "type": "string", "minLength": 3 },
          "prompt": { "type": "string" },
          "ts": { "type": "string", "format": "date-time" }
        }
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "op"],
        "properties": {
          "ts": { "type": "string" },
          "op": { "type": "string" },
          "key": { "type": ["string", "null"] },
          "result": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "isoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "render": {
      "type": "object",
      "required": ["dir", "screenshot", "html", "screenshot_sha256", "html_sha256", "rev", "fetched_at"],
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "pattern": "^docs/design/stitch/[a-z0-9][a-z0-9-]*\\.(desktop|mobile|tablet)$" },
        "screenshot": { "type": "string", "pattern": "^docs/design/stitch/.+\\.png$" },
        "html": { "type": "string", "pattern": "^docs/design/stitch/.+\\.html$" },
        "screenshot_sha256": { "$ref": "#/$defs/sha256" },
        "html_sha256": { "$ref": "#/$defs/sha256" },
        "rev": { "type": "integer", "minimum": 1 },
        "fetched_at": { "$ref": "#/$defs/isoTime" }
      }
    },
    "revision": {
      "type": "object",
      "required": ["rev", "ts", "op", "screenId", "by"],
      "additionalProperties": false,
      "properties": {
        "rev": { "type": "integer", "minimum": 1 },
        "ts": { "$ref": "#/$defs/isoTime" },
        "op": { "enum": ["generate", "edit", "variant_pick", "import", "import_correction", "adopt", "sync_back", "apply_design_system", "refresh"] },
        "screenId": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "description": "The prompt sent to Stitch (required for generate / edit / import / import_correction / sync_back)." },
        "prompt_source": { "enum": ["owner", "requirement", "change_request", "design_review", "deviation", "import_capture", "import_correction", "audit", "hotfix", "recon", "theme"] },
        "stitch_prompt": { "type": "string", "description": "Stitch's expanded prompt from the response, when it returns one." },
        "phase": { "type": ["integer", "null"] },
        "by": { "type": "string", "description": "Who sent it: parent session of /stitch, /design, /ui-audit, /autonomous…" },
        "fidelity": { "type": "number", "minimum": 0, "maximum": 1 },
        "previous_screenId": { "type": ["string", "null"] }
      }
    },
    "deviation": {
      "type": "object",
      "required": ["id", "phase", "what", "why", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^DEV-[0-9]+-[0-9]{3,}$" },
        "phase": { "type": "integer" },
        "what": { "type": "string", "minLength": 5 },
        "why": { "type": "string", "minLength": 5 },
        "source": { "enum": ["ui_developer", "mobile_developer", "hotfix", "audit"] },
        "resolution": { "enum": ["fixed", "accepted"] },
        "resolved_by": { "type": "string" },
        "resolved_at": { "$ref": "#/$defs/isoTime" },
        "synced_rev": { "type": "integer", "minimum": 1 }
      }
    },
    "screen": {
      "type": "object",
      "required": ["screenKey", "screenId", "deviceType", "app", "route", "status", "origin"],
      "additionalProperties": false,
      "properties": {
        "screenKey": { "type": "string" },
        "screenId": { "type": ["string", "null"] },
        "deviceType": { "enum": ["DESKTOP", "MOBILE", "TABLET"] },
        "app": { "enum": ["web", "mobile"] },
        "route": { "type": ["string", "null"], "pattern": "^/" },
        "title": { "type": "string" },
        "origin": { "enum": ["generated", "imported", "adopted", "reconstructed", "pending"] },
        "status": { "enum": ["approved", "conformant", "drift", "design_gap", "no_baseline", "import_low_fidelity", "pending_approval", "sync_back_pending", "orphan"] },
        "approved_by": { "enum": ["owner", "design_quality_reviewer", null] },
        "approved_at": { "anyOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },
        "approved_rev": { "type": ["integer", "null"], "minimum": 1 },
        "owner_review": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["pending", "accepted", "changes_requested"] },
            "at": { "anyOf": [{ "$ref": "#/$defs/isoTime" }, { "type": "null" }] },
            "note": { "type": "string" }
          }
        },
        "render": { "$ref": "#/$defs/render" },
        "wireframe": { "type": ["string", "null"] },
        "phase": { "type": ["integer", "null"], "description": "The last phase that changed this screen." },
        "fidelity": {
          "type": "object",
          "required": ["score", "threshold", "attempts", "method"],
          "additionalProperties": false,
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "visual": { "type": "number", "minimum": 0, "maximum": 1 },
            "structural": { "type": "number", "minimum": 0, "maximum": 1 },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "attempts": { "type": "integer", "minimum": 1, "maximum": 4 },
            "method": { "type": "string" },
            "capture": { "type": "string" },
            "missing": { "type": "array", "items": { "type": "string" } }
          }
        },
        "deferred": {
          "type": "object",
          "required": ["reason", "at", "detail"],
          "additionalProperties": false,
          "properties": {
            "reason": { "enum": ["stitch_unavailable"] },
            "at": { "$ref": "#/$defs/isoTime" },
            "detail": { "type": "string", "minLength": 3 },
            "run": { "enum": ["autonomous", "interactive"] }
          }
        },
        "deviations": { "type": "array", "items": { "$ref": "#/$defs/deviation" } },
        "history": { "type": "array", "items": { "$ref": "#/$defs/revision" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["approved", "conformant"] } } },
          "then": {
            "required": ["approved_by", "approved_at", "approved_rev", "render", "history"],
            "properties": {
              "screenId": { "type": "string", "minLength": 1 },
              "approved_by": { "enum": ["owner", "design_quality_reviewer"] },
              "approved_at": { "$ref": "#/$defs/isoTime" },
              "approved_rev": { "type": "integer" }
            }
          }
        },
        {
          "if": { "properties": { "approved_by": { "const": "design_quality_reviewer" } }, "required": ["approved_by"] },
          "then": { "required": ["owner_review"] }
        },
        {
          "if": { "properties": { "status": { "const": "import_low_fidelity" } } },
          "then": { "required": ["fidelity", "render"] }
        },
        {
          "if": { "properties": { "origin": { "const": "imported" } } },
          "then": { "required": ["fidelity"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["pending_approval", "sync_back_pending", "drift", "design_gap"] } } },
          "then": { "required": ["render", "history"], "properties": { "screenId": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "status": { "not": { "const": "orphan" } } } },
          "then": { "properties": { "route": { "type": "string" } } }
        },
        {
          "if": { "properties": { "status": { "const": "sync_back_pending" } } },
          "then": { "required": ["deviations"] }
        }
      ]
    }
  }
}
