# Non-secret coordinates of the staging environment on AWS. Fill from Terraform once the infrastructure
# exists:  scripts/k8s/eks-outputs.sh staging   (a human or CI runs it; it reads `terraform output -json`).
# Committed on purpose: ids and endpoints, never a credential. deploy-eks.sh refuses to run while any
# value is still a placeholder (account 000000000000, example.com, "placeholder").
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
EKS_CLUSTER_NAME=__APP__-staging
EKS_CLUSTER_ARN=arn:aws:eks:us-east-1:000000000000:cluster/__APP__-staging
ECR_REGISTRY=000000000000.dkr.ecr.us-east-1.amazonaws.com
APP_HOST=staging.__APP__.example.com
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/placeholder
DB_HOST=placeholder.us-east-1.rds.amazonaws.com
DB_MASTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:placeholder
DB_MIGRATOR_SECRET=__APP__/staging/db-migrator
DB_APP_SECRET=__APP__/staging/db-app
VPC_CIDR=10.0.0.0/16
