# Per-project deploy settings read by scripts/k8s/*.sh
APP=__APP__
REGISTRY=localhost:5001
INGRESS_PORT=18080
# Paths that must return 200 after every rollout (smoke.sh)
SMOKE_PATHS="/healthz /readyz"
# Optional: path returning {"git_sha": "..."} — smoke.sh checks it equals the deployed commit
VERSION_PATH=/api/version
