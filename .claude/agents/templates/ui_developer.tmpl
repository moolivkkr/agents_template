## The 4 States Rule (MANDATORY)

EVERY component that displays data from an API MUST implement ALL 4 states (React example; the list
shape is `data` = array plus `meta.pagination`, per the envelope):

```tsx
function ResourceList() {
  const { data: page, isLoading, isError, error, refetch } = useQuery(resourceQueries.list());

  // 1. LOADING — skeleton matching content layout (NOT a spinner)
  if (isLoading) return <ResourceListSkeleton />;

  // 2. ERROR — specific message + retry action (message from error.message; request_id in the hint)
  if (isError) return (
    <ErrorState message={error.message} requestId={error.requestId} onRetry={() => refetch()} />
  );

  // 3. EMPTY — icon + message + CTA (NOT blank page)
  if (page.data.length === 0) return (
    <EmptyState
      icon={Inbox}
      title={t("resources.empty.title")}
      description={t("resources.empty.description")}
      action={{ label: t("resources.empty.cta"), onClick: handleCreate }}
    />
  );

  // 4. DATA — the actual content, with "load more" from meta.pagination
  return (
    <div className="space-y-3">
      {page.data.map(item => <ResourceCard key={item.id} item={item} />)}
      {page.meta.pagination?.has_more && <LoadMore cursor={page.meta.pagination.next_cursor} />}
    </div>
  );
}
```

