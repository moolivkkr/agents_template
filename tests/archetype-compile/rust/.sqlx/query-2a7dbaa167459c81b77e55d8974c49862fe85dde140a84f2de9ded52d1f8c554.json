{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT o.id, o.tenant_id, o.total, o.status,\n               oi.id as item_id, oi.product_id, oi.quantity, oi.price\n        FROM orders o\n        LEFT JOIN order_items oi ON o.id = oi.order_id\n        WHERE o.tenant_id = $1\n        ORDER BY o.created_at DESC\n        ",
