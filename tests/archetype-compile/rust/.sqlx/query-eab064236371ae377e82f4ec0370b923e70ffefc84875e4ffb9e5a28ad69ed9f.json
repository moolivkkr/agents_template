  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, tenant_id, status as \"status: OrderStatus\", total_cents, created_at, version\n            FROM orders\n            WHERE tenant_id = $1 AND deleted_at IS NULL AND (created_at, id) < ($2, $3)\n            ORDER BY created_at DESC, id DESC\n            LIMIT $4\n            ",
